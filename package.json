{
  "name": "@alexfalconflores/better-url",
  "version": "1.0.3",
  "description": "Extension of the URL object with a fluent API (Fluent API) that allows to build URLs in a chained and readable way.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.mjs",
    "require": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfalconflores/better-url.git"
  },
  "bugs": {
    "url": "https://github.com/alexfalconflores/better-url/issues"
  },
  "homepage": "https://github.com/alexfalconflores/better-url#readme",
  "keywords": [
    "better-url",
    "url",
    "typescript",
    "utilities",
    "query",
    "builder",
    "chainable",
    "node",
    "frontend",
    "utility",
    "fluent-api"
  ],
  "author": "Alex Stefano Falcon Flores",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --watch --dts",
    "clean": "rm -rf dist",
    "test": "bun test",
    "release": "npm publish --access public"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "@types/node": "25.2.3",
    "tsup": "8.4.0",
    "typescript": "5.8.3"
  }
}
